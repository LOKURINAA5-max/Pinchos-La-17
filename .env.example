# ===== Obligatorias =====
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/pinchos17
# 32+ caracteres aleatorios:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
# development = en tu computador (HTTP). production = en el servidor: cookies seguras + HTTPS obligatorio
NODE_ENV=development

# ===== Primer arranque en la nube (sin terminal) =====
# Si la base está vacía, el sistema crea las tablas y este administrador SOLA. Después de entrar, BORRA ADMIN_CLAVE del servidor.
ADMIN_USUARIO=
ADMIN_CLAVE=
# false = no cargar el menú de ejemplo (hamburguesas, pinchos...) en una instalación nueva
CARGAR_CATALOGO_EJEMPLO=true
# true = no tocar la base al arrancar (solo si manejas las migraciones a mano)
SALTAR_ARRANQUE=

# ===== Despliegue =====
# Detrás de Caddy/Nginx/Render/Railway pon 1. En tu computador déjalo vacío
TRUST_PROXY=
# (Opcional, versiones antiguas) carpeta para fotos viejas guardadas en disco. Las fotos nuevas van a la base de datos.
UPLOADS_DIR=
# true si tu base administrada exige conexión cifrada (casi todas)
DATABASE_SSL=
# Usuario administrador de la base: SOLO para migraciones y copias, no para el servidor
DATABASE_URL_ADMIN=

# ===== Seguridad =====
# Roles que DEBEN activar verificación en dos pasos (separados por coma). Recomendado: admin
EXIGIR_2FA=
# true = los pedidos de clientes (QR/domicilio) esperan confirmación de caja antes de ir a cocina
CONFIRMAR_PEDIDOS=true
# Máximo de pedidos por IP cada 10 min (en un local todos comparten la IP del Wi-Fi)
LIMITE_PEDIDOS_10MIN=120
LOG_ACCESO=true

# ===== Pago Nequi (déjalo vacío para deshabilitar) =====
NEQUI_NUMERO=
NEQUI_NOMBRE=

# ===== Caja =====
CAJA_UMBRAL_DIFERENCIA=5000
CAJA_UMBRAL_RETIRO=100000
CAJA_MAX_HORAS_TURNO=14

# ===== Cocina (cronómetro) =====
# Minutos para pasar a amarillo y a rojo en las tarjetas de cocina
COCINA_META_MIN=10
COCINA_ALERTA_MIN=15

# --- Buscador de direcciones para domicilios (opcional) ---
# Por defecto usa OpenStreetMap (gratis). Con una llave de Google Geocoding la búsqueda es más precisa en Colombia (tiene costo según el uso).
# GOOGLE_GEOCODING_KEY=
# Correo de contacto que se envía a OpenStreetMap (lo recomienda su política de uso)
# NOMINATIM_EMAIL=
